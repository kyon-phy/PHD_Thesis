+    \small
+    \caption{Thresholds tested in the $\SR$ optimisation. Each set lists the trial values for the indicated inequality. A zero mass threshold or an angular upper threshold of $\pi$ represents no effective requirement on that variable.}
+    \label{tab:ch7_scan_variables}
+    \begin{tabular}{lcc}
+        \toprule
+        Variable & $\SR$-$\Res$ & $\SR$-$\NonRes$ \\
+        \midrule
