% ------- %
% - JOB - %
% ------- %

Job: "fit_taunub_sys"
	BlindSRs: False
	DoPieChartPlot: True
	DoSummaryPlot: True
	DoTables: True
	HistoChecks: NOCRASH
	HistoPath: ./output_plots/taunub_sys
	ImageFormat: png
	LegendX1: 0.46
	LegendX1Summary: 0.35
	LegendX2Summary: 0.9
	Lumi: 1
	LumiLabel: "140 fb^{-1}"
	MergeUnderOverFlow: True
	POI: SigXsecOverSM
	PlotLabel: Internal
	PlotOptions: NOSIG,YIELDS,OVERSIG
	PrePostFitCanvasSize: 800,600
	RatioType: DATAOVERBKG
	RatioYmax: 1.5
	RatioYmaxPostFit: 2
	RatioYmin: 0.5
	RatioYminPostFit: 0
	ReadFrom: HIST
	RecreateBinningFiles: True
	SummaryPlotYmax: 1e5
	SystControlPlots: True
	SystPruningNorm: 0.005
	SystPruningShape: 0.005
	UseGammaPulls: True

% ------- %
% - FIT - %
% ------- %

Fit: "fit"
	FitBlind: False
	FitRegion: CRONLY
	FitType: BONLY
	NumCPU: 8
	POIAsimov: 1
	UseMinos: SigXsecOverSM
	doLHscan: all

% ----------- %
% - REGIONS - %
% ----------- %

Region: "SR_1tau0l1b_sch_met"
	DataType: ASIMOV
	HistoName: NOSYS/met_SR_1tau0l1b_sch
	Label: SR_1tau0l1b_sch
	LogScale: True
	Rebinning: 0,1500
	ShortLabel: SR_1tau0l1b_sch
	Type: SIGNAL
	VariableTitle: met
	Ymax: 1e2
	Ymin: 1e-1

