% ----------------- %
% - NORM. FACTORS - %
% ----------------- %

NormFactor: "SigXsecOverSM"
	Category: Theory
	Max: 10
	Min: 0
	Nominal: 1
	Regions: *sch*
	Samples: LQ_taunub_M1500
	Title: "#mu(signal_sch)"

NormFactor: "top_Norm_tch"
	Category: top
	Constant: False
	Max: 3
	Min: 0
	Nominal: 1
	Regions: *tch*
	Samples: tt*, SingleTop*
	Title: "#mu(top_tch)"

NormFactor: "Wjets_Norm_tch"
	Category: W+jets
	Constant: False
	Max: 3
	Min: 0
	Nominal: 1
	Regions: *tch*
	Samples: W*
	Title: "#mu(Wjets_tch)"

NormFactor: "top_Norm_sch"
	Category: top
	Constant: False
	Max: 3
	Min: 0
	Nominal: 1
	Regions: *sch*
	Samples: tt*, SingleTop*
	Title: "#mu(top_sch)"

NormFactor: "Wjets_Norm_sch"
	Category: W+jets
	Constant: False
	Max: 3
	Min: 0
	Nominal: 1
	Regions: *sch*
	Samples: W*
	Title: "#mu(Wjets_sch)"

