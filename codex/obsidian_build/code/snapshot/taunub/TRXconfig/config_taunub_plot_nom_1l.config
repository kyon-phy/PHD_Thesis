% - NORM. FACTORS - %
% ----------------- %

NormFactor: "gU_square"
	Category: Theory
	Max: 10
	Min: -0.5
	Nominal: 1
	Samples: INF_M1500_gU1_0_23L0_2
	Title: "#gu^2(signal)"

NormFactor: "top_Norm_tch"
	Category: top
	Constant: False
	Max: 3
	Min: 0
	Nominal: 1
	Regions: *tch*
	Samples: tt*, SingleTop*
	Title: "#mu(top_tch)"

