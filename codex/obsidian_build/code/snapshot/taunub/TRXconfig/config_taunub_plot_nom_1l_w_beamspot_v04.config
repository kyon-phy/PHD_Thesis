Job: "fit_taunub_nom_1l_allVR_SPLUSB_alldecay_corrected"
	BlindSRs: True
	BlindingThreshold: 0.05
	BlindingType: SOVERB
	CleanTables: True
	CorrelationThreshold: 0.2
	DoPieChartPlot: True
	DoSummaryPlot: True
	DoTables: True
	HistoChecks: NOCRASH
