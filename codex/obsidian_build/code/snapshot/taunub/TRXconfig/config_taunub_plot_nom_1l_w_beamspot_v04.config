	Label: Run-2
	LegendX1: 0.46
	LegendX1Summary: 0.35
	LegendX2Summary: 0.9
	Lumi: 1
	LumiLabel: "140 fb^{-1}"
	MCstatThreshold: 0.01
	MergeUnderOverFlow: True
	POI: mu
	PlotLabel: Internal
	PlotOptions: NOSIG,YIELDS,OVERSIG
	PrePostFitCanvasSize: 800,600
	RankingMaxNP: 20
	RankingPlot: All
	RatioType: DATAOVERBKG
	RatioYmax: 2
	RatioYmaxPostFit: 2
	RatioYmin: 0
	RatioYminPostFit: 0
	ReadFrom: HIST
	RecreateBinningFiles: True
	SmoothingOption: MAXVARIATION
	SummaryPlotYmax: 1e5
	SystCategoryTables: True
	SystControlPlots: False
	SystPruningNorm: 0.01
	SystPruningShape: 0.01
	UseGammaPulls: True

% ------- %
% - FIT - %
% ------- %

Fit: "fit"
	FitBlind: False
	FitRegion: CRSR
	FitType: SPLUSB
	LHscanSteps: 20
	NumCPU: 8
	POIAsimov: 1
	UseMinos: mu
	doLHscan: mu

Limit: "limit"
    POI: mu
    LimitBlind: TRUE
    LimitType: ASYMPTOTIC
    %LimitType: TOYS
    %SplusBToys: 5000
    %BonlyToys: 5000
    %ScanSteps: 20
    %ScanMin: 0.8
    %ScanMax: 1.4

Significance: "sig"
    SignificanceBlind: TRUE
	POI: mu
	POIAsimov: 1

