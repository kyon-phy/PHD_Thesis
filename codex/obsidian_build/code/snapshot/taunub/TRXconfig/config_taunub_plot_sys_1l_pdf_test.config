% ----------------- %
% - NORM. FACTORS - %
% ----------------- %

NormFactor: "gU"
	Category: Theory
	Max: 10
	Min: -0.5
	Nominal: 1
	Samples: BSM_M1500_gU1_0_23L0_2
	Title: "#gu^4(signal)"

NormFactor: "top_Norm_tch"
	Category: top
	Constant: False
	Max: 3
	Min: 0
	Nominal: 1
	Regions: *tch*
	Samples: tt*, SingleTop*
	Title: "#mu(top_tch)"

NormFactor: "Wjets_Norm_tch"
	Category: W+jets
	Constant: False
	Max: 3
	Min: 0
	Nominal: 1
	Regions: *tch*
	Samples: W*
	Title: "#mu(Wjets_tch)"

NormFactor: "top_Norm_sch"
	Category: top
	Constant: False
	Max: 3
	Min: 0
	Nominal: 1
	Regions: *sch*
	Samples: tt*, SingleTop*
	Title: "#mu(top_sch)"

NormFactor: "Wjets_Norm_sch"
	Category: W+jets
	Constant: False
	Max: 3
	Min: 0
	Nominal: 1
	Regions: *sch*
	Samples: W*
	Title: "#mu(Wjets_sch)"

