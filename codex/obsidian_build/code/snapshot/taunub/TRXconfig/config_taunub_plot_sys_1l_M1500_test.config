% ------- %
% - JOB - %
% ------- %

Job: "fit_taunub_sys_1l_allVR_SPLUSB_MU1500_gU1_5_23L0_2_HadtauFixed_test"
	BlindingThreshold: 0.05
	BlindingType: SOVERB
	Label: "Run-2"
	CleanTables: True
	CorrelationThreshold: 0.2
	DoPieChartPlot: True
	DoSummaryPlot: True
	DoTables: True
	HistoChecks: NOCRASH
	HistoPath: /afs/cern.ch/work/z/zang/LQanalysis/taux_fastframes/run/output_plots/taunub_sys_1l_allVR_backup
	ImageFormat: pdf
	LegendX1: 0.46
	LegendX1Summary: 0.35
	LegendX2Summary: 0.9
	Lumi: 1
	LumiLabel: "140 fb^{-1}"
	MCstatThreshold: 0.01
	MergeUnderOverFlow: True
	POI: gU
	PlotLabel: Internal
	PlotOptions: NOSIG,YIELDS,OVERSIG
	PrePostFitCanvasSize: 800,600
	RankingMaxNP: 20
	RankingPlot: All
	RatioType: DATAOVERBKG
	RatioYmax: 2
	RatioYmaxPostFit: 2
	RatioYmin: 0
	RatioYminPostFit: 0
	ReadFrom: HIST
	RecreateBinningFiles: True
	SummaryPlotYmax: 1e5
	SystCategoryTables: True
	SystControlPlots: False
	SystPruningNorm: 0.01
	SystPruningShape: 0.01
	UseGammaPulls: True
	BlindSRs: TRUE


% ------- %
% - FIT - %
% ------- %

Fit: "fit"
	FitBlind: False
	FitRegion: CRSR
	FitType: SPLUSB
	NumCPU: 8
	POIAsimov: 1
	LHscanSteps: 20
	UseMinos: gU
	doLHscan: gU

