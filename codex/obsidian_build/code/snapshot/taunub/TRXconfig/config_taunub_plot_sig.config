% ------- %
% - JOB - %
% ------- %

Job: "fit_taunub_SR"
	BlindSRs: True
	DoPieChartPlot: True
	DoSummaryPlot: True
	DoTables: True
	HistoChecks: NOCRASH
	HistoPath: ./output_plots/taunub_sig
	ImageFormat: png
	LegendX1: 0.46
	Lumi: 1
	LumiLabel: "140 fb^{-1}"
	MCstatThreshold: 0.01
	POI: SigXsecOverSM
	PlotOptions: YIELDS
	PrePostFitCanvasSize: 800,700
	RatioType: DATAOVERBKG
	RatioYmax: 2
	RatioYmaxPostFit: 2
	RatioYmin: 0
	RatioYminPostFit: 0
	ReadFrom: HIST
	StatOnly: True
	SummaryPlotYmax: 1e3

% ------- %
% - FIT - %
% ------- %

Fit: "fit"
	FitBlind: True
	FitRegion: CRONLY
	FitType: BONLY
	POIAsimov: 1
	UseMinos: SigXsecOverSM
	doLHscan: all

