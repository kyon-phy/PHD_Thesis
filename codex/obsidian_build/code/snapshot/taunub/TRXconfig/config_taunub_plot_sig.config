% ----------------- %
% - NORM. FACTORS - %
% ----------------- %

NormFactor: "SigXsecOverSM"
	Max: 10
	Min: 0
	Nominal: 1
	Samples: ttbar
	Title: "#mu(signal)"

NormFactor: "top_Norm"
	Max: 3
	Min: 0
	Nominal: 1
	Samples: "ttbar","SingleTop","ttZ"
	Title: "#mu(top)"

NormFactor: "Wjets_Norm"
	Max: 3
	Min: 0
	Nominal: 1
	Samples: W*
	Title: "#mu(Wjets)"

