% ------- %
% - JOB - %
% ------- %

Job: "fit_taunub_nom_1l_VR_test"
	BlindSRs: False
	DoPieChartPlot: True
	DoSummaryPlot: True
	DoTables: True
	HistoChecks: NOCRASH
	HistoPath: ./output_plots/taunub_nom_1l_VR_test
	ImageFormat: png
	LegendX1: 0.46
	LegendX1Summary: 0.35
	LegendX2Summary: 0.9
	Lumi: 1
	LumiLabel: "140 fb^{-1}"
	MergeUnderOverFlow: True
	POI: gU_square
	PlotLabel: Internal
	PlotOptions: NOSIG,YIELDS,OVERSIG
	PrePostFitCanvasSize: 800,600
	RatioType: DATAOVERBKG
	RatioYmax: 2
	RatioYmaxPostFit: 2
	RatioYmin: 0
	RatioYminPostFit: 0
	ReadFrom: HIST
	RecreateBinningFiles: True
	SummaryPlotYmax: 1e5
	SystControlPlots: True
	SystPruningNorm: 0.005
	SystPruningShape: 0.005
	UseGammaPulls: True

% ------- %
% - FIT - %
% ------- %

Fit: "fit"
	FitBlind: False
	FitRegion: CRSR
	FitType: SPLUSB
	NumCPU: 8
	POIAsimov: 1
	UseMinos: gU_square
	doLHscan: all

% ----------- %
% - REGIONS - %
% ----------- %

